@model IEnumerable<EcoLanitas.web.Models.Product>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Productos</h2>

@foreach (var product in Model)
{
    <div>
        <h3>@product.Name</h3>
        <h3>@product.Description</h3>
        <h3>Precio: @product.Price €</h3>
        <h3>Stock: @product.Stock</h3>
    </div>
}
